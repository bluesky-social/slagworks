# /etc/slagworks/site.env
# Site worker configuration. Variables map to the env reads in
# cmd/slagworksd/site.go; check that file when adding knobs.
# Reference: docs/user/configuration.md

# Central API connection (required). https:// connects with wss://.
SLAGWORKS_API_URL=http://api.example.com:8081
SLAGWORKS_TOKEN=

# Worker identity: must equal the --worker-id the token was registered
# with (`slagctl worker register`). Unset, the worker generates a UUID on
# first start (`slagworksd site worker-id` prints it). Convention: the
# host FQDN.
SLAGWORKS_WORKER_ID=oob-gw-1.site-a.example.com

# Network identity (required): the IP this worker serves DHCP/TFTP/HTTP
# from, and the interface the DHCP server listens on. Subnets, pools, and
# reservations come from the site snapshot (NetBox-derived), not env.
SLAGWORKS_SERVER_IP=192.0.2.1
SLAGWORKS_IFACE=eth0

# Image directory. The compiled default is /srv/images, but the package
# links systemd-bootx64.efi into /var/lib/slagworks/images and readiness
# fails without it, so package installs use this path.
SLAGWORKS_IMAGES_DIR=/var/lib/slagworks/images

# Optional
# SLAGWORKS_HTTP_PORT=8080
# SLAGWORKS_TFTP_DIR=/srv/tftp
# SLAGWORKS_DEFAULT_IMAGE=noble-pxe
# SLAGWORKS_DATA_DIR=/var/lib/slagworks
# SLAGWORKS_AGENT_BIN=/usr/bin/slagworks-agent
# SLAGWORKS_HEALTH_ADDR=:9090
# debug|info|warn|error; anything else means info
# SLAGWORKS_LOG_LEVEL=info

# Supermicro SMCIPMITool (optional, operator-installed; slagworks does not
# ship it). auto|required|off (default auto). The launcher defaults to
# SMCIPMITool on PATH. See docs/user/hardware/supermicro-smcipmitool.md.
# SLAGWORKS_SMCIPMITOOL=auto
# SLAGWORKS_SMCIPMITOOL_BIN=/usr/local/bin/SMCIPMITool

# OOB DHCP takeover (only the exact value "true" enables it): also serve
# DHCP/TFTP/HTTP on the local interface that sits on the snapshot's OOB
# subnet, replacing an external DHCP server there. See
# docs/user/configuration.md.
# SLAGWORKS_OOB_DHCP_ENABLED=true

# HA (optional): with SLAGWORKS_STANDBY=true (exact value), services and
# the operation executor run only while SLAGWORKS_VIP is assigned to this
# host. The VIP itself is managed externally (e.g. keepalived; see
# deploy/keepalived.conf.tmpl) — slagworksd only watches for it.
# SLAGWORKS_STANDBY=false
# SLAGWORKS_VIP=192.0.2.10

# Self-upgrade (only the exact value "1" enables it): on a version
# mismatch with global, run the packaged upgrade helper.
# SLAGWORKS_AUTO_UPGRADE=1
