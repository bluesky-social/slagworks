# /etc/slagworks/global.env
# Central API server configuration. Variables map to the flag/env wiring
# in cmd/slagworksd/global.go; check that file when adding knobs.
# Reference: docs/user/configuration.md

# Postgres connection string. The compiled default is a local development
# database (host=localhost user=slagworks password=slagworks ...), so set
# this in any real deployment. An RDS host with no password logs in with
# RDS IAM tokens and requires sslmode=verify-full.
DATABASE_URL=host=localhost user=slagworks password=changeme dbname=slagworks sslmode=disable

# Listen address (default :8081)
# LISTEN_ADDR=:8081

# NetBox source-of-truth connection. Both are needed for the snapshot
# pipeline and the site-worker WebSocket; without them no site worker can
# connect.
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=
# NetBox API version sent in the Accept header (default 4.6). Must match
# the NetBox server's major.minor.
# NETBOX_API_VERSION=4.6

# Externally reachable URL for NetBox webhooks, and the HMAC secret the
# webhook payloads are signed with. Both are required by
# `slagctl netbox bootstrap`. With the secret empty, the webhook endpoint
# rejects every delivery (503) and NetBox changes arrive only through the
# 5-minute reconcile.
# SLAGWORKS_EXTERNAL_URL=https://slagworks.example.com
# SLAGWORKS_WEBHOOK_SECRET=

# Operator auth is OIDC-only. Both issuer and audience are REQUIRED —
# slagworksd refuses to start without them.
#
# Issuer: the `iss` value to require on tokens — the identity-provider
# host operators' browsers hit.
SLAGWORKS_OIDC_ISSUER=https://idp.example.com/application/o/slagworks/
# JWKS URL: where slagworksd fetches signing keys. May legitimately be a
# DIFFERENT host from the issuer (e.g. an in-cluster service URL) —
# keys are host-independent. Default: <issuer>/jwks/
SLAGWORKS_OIDC_JWKS_URL=https://idp.example.com/application/o/slagworks/jwks/
# Audience: the slagworks OIDC client ID (the access-token `aud` to require).
SLAGWORKS_OIDC_AUDIENCE=your-oidc-client-id
# Group(s) allowed operator access, comma-separated, any-of. REQUIRED.
SLAGWORKS_OIDC_REQUIRED_GROUPS=slagworks-operators
# Group(s) allowed to read stored device credentials in plaintext
# (`slagctl machine creds`), comma-separated, any-of. Optional: unset, every
# operator may read them; set, a caller needs an operator group above AND
# one of these.
# SLAGWORKS_OIDC_CREDENTIAL_GROUPS=slagworks-credential-readers

# Tailnet enrollment at deploy time (optional): OAuth client with the
# auth_keys scope that owns tag:<pop> for each NetBox site slug. Empty
# disables the feature.
# TAILSCALE_OAUTH_CLIENT_ID=
# TAILSCALE_OAUTH_CLIENT_SECRET=

# Deployed hostname template (optional). Unset: the hostname is the NetBox
# device name. {name} is the whole device name; {node} and {zone} are the
# parts before and after its last dot, so this example turns a device named
# kworker-1.site1 into kworker-1.internal.site1.example.net.
# SLAGWORKS_HOSTNAME_TEMPLATE={node}.internal.{zone}.example.net

# AWS: BMC/PDU credentials are read from Secrets Manager
# (pop/<pop>/bmc-creds-admin, pop/<pop>/bmc-creds-monitor) in us-east-2
# with the default AWS SDK credential chain. The region is fixed;
# AWS_REGION does not change it.
