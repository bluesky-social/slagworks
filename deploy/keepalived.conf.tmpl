# Slagworks Keepalived config template.
# Render with envsubst: PRIORITY=100 VIP=10.0.0.1 envsubst < keepalived.conf.tmpl > /etc/keepalived/keepalived.conf
# Primary: PRIORITY=100, Standby: PRIORITY=50. Both start as BACKUP with nopreempt.
vrrp_instance SLAGWORKS {
    state BACKUP
    interface eth0
    virtual_router_id 51
    priority ${PRIORITY}
    nopreempt
    advert_int 1
    virtual_ipaddress {
        ${VIP}/24
    }
}
