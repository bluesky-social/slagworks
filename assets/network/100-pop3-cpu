#!/usr/bin/env python3
# slagworks:match site=pop3
# slagworks:match device_type=rs501a-e12-rs4u
# slagworks:match hostname=/^cpu\d+\.pop3$/
# slagworks:priority 100
#
# pop3 cpu host network config (cpu1/cpu2/cpu3.pop3, the ASUS RS501A-E12-RS4U
# hosts). Sibling of 150-pop3-oob-gw and 150-pop3-router — same structural-
# baseline philosophy and transitional-egress divergence, adapted for the cpu
# host's interface set.
#
# MATCH KEYS: device_type=rs501a-e12-rs4u is the primary
# discriminator; site=pop3 scopes it (an RS501A could appear elsewhere later).
# The hostname regex is the defense-in-depth AND-constraint, and deliberately
# excludes gpu1.pop3 (a different config, out of scope for this script) — an
# RS501A that isn't cpuN fails safe to DHCP.
#
# STRUCTURAL FABRIC BASELINE AT INSTALL TIME: the two routed /31 leaf legs +
# the identity loopback /32 + the OOB mgmt leg with a transitional default via
# oob-gw-1 + public DNS. FRR / final addressing / fabric migration are
# ansible-owned (Phase 5 of site Ansible docs/plans/2026-07-09-pop3-fabric-
# bringup.md); no FRR is emitted here, unlike the pop1 kworker script,
# because pop3 hosts ride the OOB copper until Phase 5 migrates defaults onto
# the fabric per-host.
#
# TRANSITIONAL DEFAULT VIA oob-gw-1, NOT THE FABRIC: between image and ansible-
# converge the box needs egress (tailscale deploy-enrollment, apt, phone-home
# beyond the L2). The host's OOB leg is eno1 on the copper 10.252.244.0/22;
# oob-gw-1 holds 10.252.244.11 on the same L2 and masquerades eno3-sourced
# traffic out its WAN (the oob_wan_egress design). The legacy 10.252.1.0/24
# and router1's 10.252.1.1 were retired 2026-10-19. The router script uses
# the 10.252.240.1 VIP instead because its OOB leg sits on 10.252.240.0/22;
# this host's leg is on .244, so it defaults via oob-gw-1's on-subnet address.
# The default route MUST carry on-link: true — an unresolvable-
# gateway static route leaves the link stuck `configuring`, which blocks
# wait-online -> network-online.target -> phone-home (the same wedge the
# router script's comment documents). All three pop3 scripts now carry this.
#
# HARD FAIL, no DHCP fallback (same posture as every sibling script): >=2 /31
# legs, a loopback /32, and exactly one OOB NIC or the deploy aborts.
#
# Emits the emit-bundle contract on stdout:
#   {"files": [{"path","content","mode","owner","group"}], "enable_units": []}
#
# Shared plumbing: slagworks_netlib.

import ipaddress
import sys

import slagworks_netlib as nl

MTU = 9000  # matches the leaf routed-port MTU (the L3 fabric)

# Transitional egress (see the divergence note above): default via oob-gw-1's
# copper address, public resolvers. Both are replaced wholesale by the ansible cpu-host role.
TRANSITIONAL_GATEWAY = "10.252.244.11"
TRANSITIONAL_DNS = ["1.1.1.1", "1.0.0.1"]


def find_legs(ifaces):
    """Routed fabric legs: physical NICs carrying a /31, each as (name, mac,
    cidr). Sorted numerically by host IP. Skips legs with no MAC."""
    legs = []
    for i in ifaces:
        if i.get("type") != "physical":
            continue
        ip = i.get("ip", "")
        if not ip.endswith("/31"):
            continue
        mac = (i.get("mac") or "").lower()
        name = i.get("name", "")
        if not mac:
            sys.stderr.write(
                f"WARNING: routed leg {name!r} has no MAC in facts; skipping "
                f"it (cannot match-by-MAC in netplan).\n"
            )
            continue
        legs.append((name, mac, ip))
    legs.sort(key=lambda leg: int(ipaddress.ip_interface(leg[2]).ip))
    return legs


def find_loopback(ifaces):
    """The identity loopback: a /32 on the `lo` interface."""
    for i in ifaces:
        if i.get("name") == "lo" and i.get("ip", "").endswith("/32"):
            return i["ip"]
    return ""


def find_oob_nic(ifaces):
    """The OOB management NIC: physical, non-/31, non-BMC, private IP + MAC.
    Exactly one expected (ipmi is BMC by name)."""
    candidates = []
    for i in ifaces:
        if i.get("type") != "physical":
            continue
        ip = i.get("ip", "")
        if ip.endswith("/31"):
            continue
        name = i.get("name", "")
        if nl.is_bmc_name(name):
            continue
        mac = (i.get("mac") or "").lower()
        if not ip or not mac:
            continue
        if not nl.is_private_ip(ip):
            continue
        candidates.append((name, mac, ip))
    if len(candidates) != 1:
        names = [c[0] for c in candidates]
        nl.fail(
            "ERROR: expected exactly one OOB management NIC (physical, "
            "non-/31, non-BMC, private IP) on this pop3 cpu host; found {}. "
            "The OOB leg must carry a modeled private OOB address so the "
            "host phones home. Fix the NetBox model and redeploy.\n".format(
                names or "none")
        )
    return candidates[0]


def render_netplan(legs, loopback, oob_name, oob_mac, oob_ip):
    """OOB mgmt leg (with the transitional default + public DNS) + routed /31
    legs + loopback /32. FRR / final addressing are ansible-owned."""
    lines = []
    lines.append("# slagworks deploy agent - pop3 cpu host (assets/network/100-pop3-cpu).")
    lines.append("# TRANSITIONAL config: structural L3 baseline (two /31 leaf legs + identity")
    lines.append("# loopback) + OOB leg with a default via oob-gw-1 + public DNS so the box has")
    lines.append("# egress before ansible converges. The ansible cpu-host role rewrites this")
    lines.append("# file wholesale: final addressing, FRR-owned default, fabric migration.")
    lines.append("# Do not treat this as steady state - converge is mandatory.")
    lines.append("network:")
    lines.append("  version: 2")
    lines.append("  renderer: networkd")
    lines.append("  ethernets:")
    # OOB management leg: static address + transitional default route.
    lines.append(f"    {oob_name}:")
    lines.append("      match:")
    lines.append(f'        macaddress: "{oob_mac}"')
    lines.append(f"      set-name: {oob_name}")
    lines.append("      dhcp4: false")
    lines.append("      dhcp6: false")
    lines.append("      addresses:")
    lines.append(f'        - "{oob_ip}"')
    lines.append("      routes:")
    lines.append("        - to: default")
    lines.append(f"          via: {TRANSITIONAL_GATEWAY}")
    # on-link: networkd treats a static route whose gateway it cannot resolve
    # as a CONFIGURATION FAILURE that leaves the link stuck in `configuring`
    # (never `configured`), which blocks systemd-networkd-wait-online and with
    # it network-online.target and the phone-home unit. on-link installs the
    # route bound to the interface regardless of the modeled OOB prefix, so a
    # prefix-modeling change (or a test-subnet OOB address) can never wedge
    # first boot on an uninstallable default.
    lines.append("          on-link: true")
    lines.append("      nameservers:")
    lines.append(f"        addresses: [{', '.join(TRANSITIONAL_DNS)}]")
    # Routed fabric legs: match-by-MAC + set-name, /31 address, fabric MTU.
    # Dark until the leaves are imaged/converged; harmless to carry now.
    for name, mac, cidr in legs:
        lines.append(f"    {name}:")
        lines.append("      match:")
        lines.append(f'        macaddress: "{mac}"')
        lines.append(f"      set-name: {name}")
        lines.append("      dhcp4: false")
        lines.append("      dhcp6: false")
        lines.append("      addresses:")
        lines.append(f'        - "{cidr}"')
        lines.append(f"      mtu: {MTU}")
    # Identity loopback /32 on lo. Ansible's FRR uses it as the bgp router-id.
    lines.extend(nl.loopback_lines(loopback))
    return "\n".join(lines) + "\n"


def main():
    ifaces = nl.load_facts()

    legs = find_legs(ifaces)
    loopback = find_loopback(ifaces)
    if len(legs) < 2 or not loopback:
        leg_ips = sorted(leg[2] for leg in legs)
        nl.fail(
            "ERROR: matched the pop3 cpu host network script but the host is "
            "not fully L3-modeled in NetBox: found {} /31 leg(s) {} and "
            "loopback={!r} (need >=2 legs and a /32 on lo). The leaf legs + "
            "the lo loopback /32 must be modeled ACTIVE on this device "
            "(reserved IPs are invisible to the facts). Fix NetBox and "
            "redeploy - refusing to bring this host up DHCP-only.\n".format(
                len(legs), leg_ips, loopback)
        )

    oob_name, oob_mac, oob_ip = find_oob_nic(ifaces)

    netplan = render_netplan(legs, loopback, oob_name, oob_mac, oob_ip)

    nl.emit(nl.bundle([
        # 0600: netplan warns on world-readable config.
        nl.file_entry("/etc/netplan/99-slagworks.yaml", netplan, mode="0600"),
    ]))


if __name__ == "__main__":
    main()
