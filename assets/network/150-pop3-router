#!/usr/bin/env python3
# slagworks:match site=pop3
# slagworks:match device_type=minisforum-ms-01
# slagworks:match hostname=/^router1\.pop3$/
# slagworks:priority 150
#
# pop3 router network config (router1.pop3, the Minisforum MS-01). Sibling of
# 150-pop3-oob-gw — same structural-baseline philosophy and transitional-
# egress divergence, adapted for the router's interface set.
#
# MATCH KEYS: device_type=minisforum-ms-01 is unique in the fleet
# today; site=pop3 + the hostname regex are the defense-in-depth
# AND-constraints so a future MS-01 elsewhere fails safe to DHCP.
#
# STRUCTURAL FABRIC BASELINE AT INSTALL TIME: the two routed /31 leaf
# downlinks (10.252.25.9 -> leaf-1 swp30, 10.252.25.13 -> leaf-2 swp30) + the
# identity loopback /32 (10.252.31.1) + the OOB leg. The EIA WAN /30s, FRR
# (eBGP transit + fabric + AWS VPN), nftables, and final addressing are all
# ansible-owned (routers.yaml). Fabric plan: site Ansible
# docs/plans/2026-07-09-pop3-fabric-bringup.md.
#
# TRANSITIONAL DEFAULT VIA oob-gw-1, NOT THE EIA DROP: between image and
# ansible-converge the box needs egress (tailscale deploy-enrollment, apt,
# phone-home beyond the L2). This host is normally pop3's OWN default gateway
# (it can't default via itself), and its real egress (EIA) is
# BGP-driven, which doesn't exist until ansible brings up FRR. During the
# window the only working egress at pop3 is oob-gw-1's dedicated WAN drop:
# oob-gw-1 masquerades OOB-sourced traffic out its WAN (the oob_wan_egress
# design, site Ansible docs/2026-06-20-oob-net-wan-egress.md). So: default via
# the oob-gw OOB VIP (10.252.240.1; the legacy 10.252.1.0/24 and oob-gw-1's
# 10.252.1.20 were retired 2026-10-19), public resolvers for DNS. The ansible routers role
# rewrites netplan wholesale at converge, which removes both in the same pass
# that brings up the EIA legs + FRR. If ansible ever stops owning netplan on
# this host, this default becomes a distance-0 route permanently shadowing
# BGP's — the divergence is safe ONLY because converge is mandatory and
# immediate (the box is not a router at all without the role).
#
# THE EIA NICs ARE DELIBERATELY NOT RENDERED: their /30s carry public IPs
# (NetBox models them active on eia1/eia2), and bringing a transit interface
# up addressed-but-unfirewalled before nftables exists would expose the box.
# find_oob_nic's private-IP filter excludes them naturally; ansible brings
# them up inside the same converge that installs the ruleset.
#
# HARD FAIL, no DHCP fallback (same posture as every sibling script): >=2 /31
# legs, a loopback /32, and exactly one OOB NIC or the deploy aborts.
#
# Emits the emit-bundle contract on stdout:
#   {"files": [{"path","content","mode","owner","group"}], "enable_units": []}
#
# Shared plumbing: slagworks_netlib.

import ipaddress
import sys

import slagworks_netlib as nl

MTU = 9000  # matches the leaf routed-port MTU (the L3 fabric)

# Transitional egress (see the divergence note above): default via oob-gw-1's
# OOB address, public resolvers. Both are replaced wholesale by the ansible
# routers role.
TRANSITIONAL_GATEWAY = "10.252.240.1"
TRANSITIONAL_DNS = ["1.1.1.1", "1.0.0.1"]


def find_legs(ifaces):
    """Routed fabric legs: physical NICs carrying a /31, each as (name, mac,
    cidr). Sorted numerically by host IP. Skips legs with no MAC."""
    legs = []
    for i in ifaces:
        if i.get("type") != "physical":
            continue
        ip = i.get("ip", "")
        if not ip.endswith("/31"):
            continue
        mac = (i.get("mac") or "").lower()
        name = i.get("name", "")
        if not mac:
            sys.stderr.write(
                f"WARNING: routed leg {name!r} has no MAC in facts; skipping "
                f"it (cannot match-by-MAC in netplan).\n"
            )
            continue
        legs.append((name, mac, ip))
    legs.sort(key=lambda leg: int(ipaddress.ip_interface(leg[2]).ip))
    return legs


def find_loopback(ifaces):
    """The identity loopback: a /32 on the `lo` interface."""
    for i in ifaces:
        if i.get("name") == "lo" and i.get("ip", "").endswith("/32"):
            return i["ip"]
    return ""


def find_oob_nic(ifaces):
    """The OOB management NIC: physical, non-/31, non-BMC, private IP + MAC.
    Exactly one expected — the EIA WAN NICs carry public /30s and fall out of
    the private-IP filter (deliberately unrendered, see header)."""
    candidates = []
    for i in ifaces:
        if i.get("type") != "physical":
            continue
        ip = i.get("ip", "")
        if ip.endswith("/31"):
            continue
        name = i.get("name", "")
        if nl.is_bmc_name(name):
            continue
        mac = (i.get("mac") or "").lower()
        if not ip or not mac:
            continue
        if not nl.is_private_ip(ip):
            continue
        candidates.append((name, mac, ip))
    if len(candidates) != 1:
        names = [c[0] for c in candidates]
        nl.fail(
            "ERROR: expected exactly one OOB management NIC (physical, "
            "non-/31, non-BMC, private IP) on this pop3 router; found {}. The "
            "OOB leg must carry a modeled private OOB address so the host "
            "phones home. Fix the NetBox model and redeploy.\n".format(
                names or "none")
        )
    return candidates[0]


def render_netplan(legs, loopback, oob_name, oob_mac, oob_ip):
    """OOB leg (with the transitional default via oob-gw-1 + public DNS) +
    routed /31 leaf downlinks + loopback /32. EIA WAN / FRR / final
    addressing are ansible-owned."""
    lines = []
    lines.append("# slagworks deploy agent - pop3 router (assets/network/150-pop3-router).")
    lines.append("# TRANSITIONAL config: structural L3 baseline (two /31 leaf downlinks +")
    lines.append("# identity loopback) + OOB leg with a default via oob-gw-1 (whose WAN")
    lines.append("# masquerades OOB egress) + public DNS, so the box has egress before")
    lines.append("# ansible converges. The ansible routers role (routers.yaml) rewrites this")
    lines.append("# file wholesale: EIA WAN legs, FRR-owned default, final addressing.")
    lines.append("# Do not treat this as steady state - converge is mandatory.")
    lines.append("network:")
    lines.append("  version: 2")
    lines.append("  renderer: networkd")
    lines.append("  ethernets:")
    # OOB leg: static address + transitional default route via oob-gw-1.
    lines.append(f"    {oob_name}:")
    lines.append("      match:")
    lines.append(f'        macaddress: "{oob_mac}"')
    lines.append(f"      set-name: {oob_name}")
    lines.append("      dhcp4: false")
    lines.append("      dhcp6: false")
    lines.append("      addresses:")
    lines.append(f'        - "{oob_ip}"')
    lines.append("      routes:")
    lines.append("        - to: default")
    lines.append(f"          via: {TRANSITIONAL_GATEWAY}")
    # on-link: the gateway (oob-gw-1's OOB address) is inside the OOB /24 on
    # the real box, so this is semantically a no-op there — but it matters:
    # networkd treats a static route whose gateway it cannot resolve as a
    # CONFIGURATION FAILURE that leaves the link stuck in `configuring`
    # (never `configured`), which blocks systemd-networkd-wait-online and
    # with it network-online.target and the phone-home unit. on-link installs
    # the route bound to the interface regardless of the modeled OOB prefix,
    # so a prefix-modeling change (or the QEMU test's test-subnet OOB
    # address) can never wedge first boot on an uninstallable default.
    lines.append("          on-link: true")
    lines.append("      nameservers:")
    lines.append(f"        addresses: [{', '.join(TRANSITIONAL_DNS)}]")
    # Routed leaf downlinks: match-by-MAC + set-name, /31 address, fabric MTU.
    for name, mac, cidr in legs:
        lines.append(f"    {name}:")
        lines.append("      match:")
        lines.append(f'        macaddress: "{mac}"')
        lines.append(f"      set-name: {name}")
        lines.append("      dhcp4: false")
        lines.append("      dhcp6: false")
        lines.append("      addresses:")
        lines.append(f'        - "{cidr}"')
        lines.append(f"      mtu: {MTU}")
    # Identity loopback /32 on lo. Ansible's FRR uses it as the bgp router-id.
    lines.extend(nl.loopback_lines(loopback))
    return "\n".join(lines) + "\n"


def main():
    ifaces = nl.load_facts()

    legs = find_legs(ifaces)
    loopback = find_loopback(ifaces)
    if len(legs) < 2 or not loopback:
        leg_ips = sorted(leg[2] for leg in legs)
        nl.fail(
            "ERROR: matched the pop3 router network script but the host is "
            "not fully L3-modeled in NetBox: found {} /31 leg(s) {} and "
            "loopback={!r} (need >=2 legs and a /32 on lo). The leaf1/leaf2 "
            "/31 downlinks + the lo loopback /32 must be modeled ACTIVE on "
            "this device (reserved IPs are invisible to the facts). Fix "
            "NetBox and redeploy - refusing to bring this router up "
            "DHCP-only.\n".format(len(legs), leg_ips, loopback)
        )

    oob_name, oob_mac, oob_ip = find_oob_nic(ifaces)

    netplan = render_netplan(legs, loopback, oob_name, oob_mac, oob_ip)

    nl.emit(nl.bundle([
        # 0600: netplan warns on world-readable config.
        nl.file_entry("/etc/netplan/99-slagworks.yaml", netplan, mode="0600"),
    ]))


if __name__ == "__main__":
    main()
