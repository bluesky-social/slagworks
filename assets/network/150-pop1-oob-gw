#!/usr/bin/env python3
# slagworks:match site=pop1
# slagworks:match device_type=dell-r640
# slagworks:match hostname=/oob-gw-[12]\.pop1/
# slagworks:priority 150
#
# pop1 oob-gw network config (oob-gw-1.pop1, oob-gw-2.pop1).
#
# MATCH KEYS: pop1 is a whole-site config (one location,
# pop1-02-004730) co-residing multiple topology families, so site=pop1 alone is
# NOT enough — device_type=dell-r640 is the PRIMARY discriminator (the kworkers
# are supermicro, the switches mellanox). The hostname regex is a
# defense-in-depth AND-constraint, not the primary key. NOTE dell-r640 is shared
# by oob-gws across ALL pops; site=pop1 scopes this to pop1's pair, and the
# pop2 oob-gw scripts key on their own location — so the three never overlap.
# (No location= pin here: pop1 has a single location, so site+device_type+
# hostname already uniquely select the pair.)
#
# STRUCTURAL FABRIC BASELINE AT INSTALL TIME (philosophy per
# docs/bsky/2026-06-21-oob-gw-fleet-fabric-bringup.md): lay down the large,
# slow-to-change fabric structure — the two routed /31 leaf legs + the identity
# loopback /32 — at OS-install time, plus the OOB mgmt leg for phone-home, so
# ansible converges from a known-good baseline. This is the L3 routed-NIC family
# (like the pop1 kworker), NOT an L2 bond (the pop2 old cage). The pop1 oob-gws
# uplink to leaf-4 + leaf-6 over point-to-point /31s and carry a loopback /32 as
# their BGP router-id / identity.
#
# Three legs in, one leg + ALL of FRR deliberately OUT:
#
#   - leaf{4,6} (the 25G data fabric): each a routed /31 P2P leg to its leaf,
#     mtu 9000. THE structural baseline this script establishes.
#   - lo: the identity loopback /32 (the host's BGP router-id). Structural
#     identity state ansible's FRR expects to find already present.
#   - eno3 (OOB mgmt): static OOB address so the host phones home. The site
#     worker runs on the oob-gw pair and serves DHCP/HTTP on this same OOB /22,
#     so the host is L2-adjacent — phone-home needs NO default route.
#   - eno1np0 (WAN): NOT touched. Public /30; FRR owns its default-route policy
#     (BGP default + per-VPN-tunnel host routes). Left dark for ansible+FRR.
#
# WHY NO FRR HERE (resolving plan open-question 2 for the oob-gw case): unlike
# the pop1 KWORKER script — which bakes a minimal announce-loopback FRR to make
# its loopback BGP-routable at first boot, because a kworker has NO OOB leg and
# that loopback is the ONLY way ansible can reach it (the bootstrap
# chicken-and-egg) — the pop1 oob-gw is fundamentally different on both counts:
#   1. It HAS an OOB leg (eno3); ansible reaches it there regardless of whether
#      the loopback is announced. No chicken-and-egg to solve.
#   2. Its real FRR is NOT a clean subset of the kworker's: it runs AWS Transit
#      Gateway VPN peering (over XFRM tunnels that don't exist at install),
#      OOB-subnet announcement, two BGP roles, and transit-prevention policy —
#      all heavily ansible-owned (pop/roles/frr oob-gw.conf.j2). Emitting a
#      "minimal" FRR here that ansible then fully overwrites with a very
#      different config is lower value than for the kworker and risks a
#      half-configured bgpd flapping at first boot before ansible converges.
# So this script emits netplan ONLY; FRR (and the loopback's announcement) is
# entirely ansible's. The loopback /32 is still laid down in netplan as identity
# state. If a future need arises to make the oob-gw loopback routable pre-ansible
# (it doesn't today), revisit — but keep the AWS-VPN FRR out of the bootstrap.
#
# NO DEFAULT ROUTE: the OOB leg is L2-adjacent to the site worker; the real
# default lives on the WAN via FRR (ansible-owned). DNS points at the on-segment
# OOB VIP ({a}.{b}.240.1, L2-reachable without a default route), NOT public
# resolvers — same convention as 100-hot-spare-pop2 / 150-pop2-oldcage-oob-gw.
#
# Driven by the per-host NetBox interface facts in SLAGWORKS_NETWORK_FACTS
# (model.SnapshotInterface): a /32 on `lo` is the loopback; a /31 on a physical
# NIC is a routed leg (rendered by MAC + set-name); eno3 is the lone physical,
# non-leg, non-BMC NIC with a private IP.
#
# Emits the emit-bundle contract on stdout:
#   {"files": [{"path","content","mode","owner","group"}], "enable_units": []}
#
# HARD FAIL, no DHCP fallback (mirrors the L3-kworker / bond loud-fail posture):
# this script only runs because the host matched the pop1 oob-gw keys, so it IS
# one and MUST be L3-modeled — >=2 /31 legs, a loopback /32, and an OOB NIC. A
# missing piece means the NetBox model is incomplete (the leaf legs + loopback
# are NOT modeled on these gws today — that modeling is the documented
# prerequisite before this script can render live). Coming up DHCP-only would
# strand the gateway. Exit non-zero to abort the deploy.
#
# Shared plumbing (facts I/O, VIP resolver, BMC/private predicates, loopback/OOB
# helpers): slagworks_netlib.

import ipaddress
import sys

import slagworks_netlib as nl

MTU = 9000  # matches the leaf routed-port MTU (the L3 fabric)


def find_legs(ifaces):
    """Routed fabric legs: physical NICs carrying a /31, each as (name, mac,
    cidr). Sorted numerically by host IP for deterministic ordering. Skips legs
    with no MAC (can't match-by-MAC)."""
    legs = []
    for i in ifaces:
        if i.get("type") != "physical":
            continue
        ip = i.get("ip", "")
        if not ip.endswith("/31"):
            continue
        mac = (i.get("mac") or "").lower()
        name = i.get("name", "")
        if not mac:
            sys.stderr.write(
                f"WARNING: routed leg {name!r} has no MAC in facts; skipping "
                f"it (cannot match-by-MAC in netplan).\n"
            )
            continue
        legs.append((name, mac, ip))
    # Numeric sort by host IP (NOT lexical: '10.254.25.11' must sort after
    # '10.254.25.9'). Deterministic leg0/leg1 ordering.
    legs.sort(key=lambda leg: int(ipaddress.ip_interface(leg[2]).ip))
    return legs


def find_loopback(ifaces):
    """The identity loopback: a /32 on the `lo` interface. Returns the CIDR or
    "" if absent."""
    for i in ifaces:
        if i.get("name") == "lo" and i.get("ip", "").endswith("/32"):
            return i["ip"]
    return ""


def find_oob_nic(ifaces):
    """The OOB management NIC: physical, NOT a routed leg (no /31), NOT a BMC
    port, carrying a PRIVATE IP + a MAC. Exactly one expected (the WAN carries a
    PUBLIC IP, excluded by the private filter; legs are /31, excluded; ipmi0 by
    name). Returns (name, mac, ip) or exits non-zero."""
    candidates = []
    for i in ifaces:
        if i.get("type") != "physical":
            continue
        ip = i.get("ip", "")
        if ip.endswith("/31"):  # a routed fabric leg, not the OOB NIC
            continue
        name = i.get("name", "")
        if nl.is_bmc_name(name):
            continue
        mac = (i.get("mac") or "").lower()
        if not ip or not mac:
            continue
        if not nl.is_private_ip(ip):  # excludes the public WAN leg
            continue
        candidates.append((name, mac, ip))
    if len(candidates) != 1:
        names = [c[0] for c in candidates]
        nl.fail(
            "ERROR: expected exactly one OOB management NIC (physical, "
            "non-/31, non-BMC, private IP) on this pop1 oob-gw; found {}. The "
            "OOB leg (eno3) must carry a modeled private OOB address so the "
            "host phones home. Fix the NetBox model and redeploy.\n".format(
                names or "none")
        )
    return candidates[0]


def render_netplan(legs, loopback, oob_name, oob_mac, oob_ip):
    """Render the netplan: OOB mgmt leg + routed /31 legs + loopback /32. NO
    FRR, NO default route (both ansible-owned — see the module docstring)."""
    lines = []
    lines.append("# slagworks deploy agent - pop1 oob-gw (assets/network/150-pop1-oob-gw).")
    lines.append("# Structural L3 fabric baseline at install time: two routed /31 leaf legs +")
    lines.append("# identity loopback /32 + the OOB mgmt leg for phone-home. FRR (incl. the AWS")
    lines.append("# VPN peering + loopback announcement), WAN, default route + keepalived are")
    lines.append("# ansible-owned and converge post-boot. NICs matched by MAC so a rename in the")
    lines.append("# deployed OS keeps the binding.")
    lines.append("network:")
    lines.append("  version: 2")
    lines.append("  renderer: networkd")
    lines.append("  ethernets:")
    # OOB management leg: static OOB address, no default route.
    lines.extend(nl.oob_leg_lines(oob_name, oob_mac, oob_ip, nl.vip_nameserver(oob_ip)))
    # Routed fabric legs: match-by-MAC + set-name, /31 address, fabric MTU. No
    # per-leg default route (FRR owns the default; a netplan kernel default at
    # distance 0 would shadow BGP's and pin egress to one leg).
    for name, mac, cidr in legs:
        lines.append(f"    {name}:")
        lines.append("      match:")
        lines.append(f'        macaddress: "{mac}"')
        lines.append(f"      set-name: {name}")
        lines.append("      dhcp4: false")
        lines.append("      dhcp6: false")
        lines.append("      addresses:")
        lines.append(f'        - "{cidr}"')
        lines.append(f"      mtu: {MTU}")
    # Identity loopback /32 on lo (alongside 127.0.0.1/8). Structural identity
    # state; ansible's FRR uses it as the bgp router-id.
    lines.extend(nl.loopback_lines(loopback))
    return "\n".join(lines) + "\n"


def main():
    ifaces = nl.load_facts()

    legs = find_legs(ifaces)
    loopback = find_loopback(ifaces)
    if len(legs) < 2 or not loopback:
        # HARD FAIL — do NOT silently fall back to DHCP. This script only runs
        # because the host matched the pop1 oob-gw keys, i.e. it is SUPPOSED to
        # be an L3-fabric gateway. Fewer than two /31 legs or no loopback /32
        # means its NetBox model is incomplete — and on these gws today the
        # leaf legs + loopback are NOT modeled yet (only eno3/WAN/idrac are), so
        # this is the expected state until that modeling lands (the documented
        # prerequisite). Bringing the host up DHCP-only would silently leave it
        # off the L3 fabric. Fail loud so the operator models the legs +
        # loopback in NetBox and redeploys, same posture as the kworker script.
        leg_ips = sorted(leg[2] for leg in legs)
        nl.fail(
            "ERROR: matched the pop1 oob-gw network script but the host is not "
            "fully L3-modeled in NetBox: found {} /31 leg(s) {} and "
            "loopback={!r} (need >=2 legs and a /32 on lo). The leaf4/leaf6 "
            "uplinks + the lo loopback /32 are most likely not yet modeled on "
            "this device. Model them and redeploy - refusing to bring this "
            "gateway up DHCP-only, which would silently leave it off the L3 "
            "fabric.\n".format(len(legs), leg_ips, loopback)
        )

    oob_name, oob_mac, oob_ip = find_oob_nic(ifaces)

    netplan = render_netplan(legs, loopback, oob_name, oob_mac, oob_ip)

    nl.emit(nl.bundle([
        # 0600: netplan warns on world-readable config.
        nl.file_entry("/etc/netplan/99-slagworks.yaml", netplan, mode="0600"),
    ]))


if __name__ == "__main__":
    main()
