+	}
+}
+
+// defaultOpTrustWindow outlasts a global restart or upgrade with room to
+// spare, and is short next to the time a host stays in service.
+const defaultOpTrustWindow = 10 * time.Minute
+
+func opTrustWindowFromEnv() time.Duration {
+	if v := os.Getenv("SLAGWORKS_OP_TRUST_WINDOW"); v != "" {
+		if d, err := time.ParseDuration(v); err == nil && d > 0 {
+			return d
+		}
+		slog.Warn("ignoring SLAGWORKS_OP_TRUST_WINDOW: want a positive duration such as 10m", "value", v)
+	}
+	return defaultOpTrustWindow
+}
+
+// setUplink records whether global is reachable.
+func (o *opState) setUplink(connected bool) {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	switch {
+	case connected:
+		o.uplinkLostAt = time.Time{}
+	case o.uplinkLostAt.IsZero():
+		o.uplinkLostAt = time.Now()
 	}
 }
 
+// staleWithoutGlobalLocked reports whether op is one this worker should no
+// longer boot a host into the installer for: global has been unreachable
+// for longer than the trust window and this worker has not driven the op
+// in that time. Caller holds mu.
+func (o *opState) staleWithoutGlobalLocked(op *model.Operation) bool {
+	if op == nil || o.uplinkLostAt.IsZero() || time.Since(o.uplinkLostAt) <= o.trustWindow {
+		return false
+	}
+	at, ok := o.lastDriven[op.ID.String()]
+	return !ok || time.Since(at) > o.trustWindow
+}
+
+// bootPrefixPhase reports whether phase is one the worker records while
+// answering the host's own DHCP and boot-script requests.
+func bootPrefixPhase(phase string) bool {
+	return phase == "dhcp_ack" || phase == "ipxe_dhcp" || phase == "ipxe_loaded"
+}
