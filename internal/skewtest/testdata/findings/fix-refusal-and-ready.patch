diff --git a/internal/worker/wsconn.go b/internal/worker/wsconn.go
index 6e57c357..8fcb8310 100644
--- a/internal/worker/wsconn.go
+++ b/internal/worker/wsconn.go
@@ -43,6 +43,9 @@ type WSConn struct {
 	conn   *ws.Conn // current active connection (nil when disconnected)
 
 	syncedOnce sync.Once
+	// readyFromCache guards the READY=1 Run sends when the first connection
+	// attempt fails but the cache holds a snapshot.
+	readyFromCache sync.Once
 	syncedCh   chan struct{} // closed after first successful snapshot apply
 
 	pendingMu sync.Mutex
@@ -329,6 +332,12 @@ func (w *WSConn) Run(ctx context.Context) error {
 		w.connected.Store(false)
 		if wasConnected {
 			backoff = time.Second
+		} else if w.cache != nil && w.cache.LastSeqNum() != 0 {
+			// Global is unreachable or refuses us, and the daemon serves
+			// boots from the snapshot worker.db held: that is up, as far as
+			// systemd is concerned. Waiting for a connection here would let
+			// the unit's start timeout kill a worker that is serving.
+			w.readyFromCache.Do(func() { _ = sdnotify.Send(sdnotify.Ready) })
 		}
 		w.log.Warn("WebSocket disconnected, reconnecting", "err", err, "backoff", backoff)
 
diff --git a/internal/ws/conn.go b/internal/ws/conn.go
index 239b725b..b352b705 100644
--- a/internal/ws/conn.go
+++ b/internal/ws/conn.go
@@ -4,7 +4,9 @@ import (
 	"context"
 	"encoding/json"
 	"fmt"
+	"io"
 	"net/http"
+	"strings"
 	"time"
 
 	"github.com/coder/websocket"
@@ -50,8 +52,17 @@ func Accept(w http.ResponseWriter, r *http.Request, opts *websocket.AcceptOption
 
 // Dial opens a WebSocket connection to the given URL (client-side).
 func Dial(ctx context.Context, url string, opts *websocket.DialOptions) (*Conn, error) {
-	c, _, err := websocket.Dial(ctx, url, opts) //nolint:bodyclose // websocket owns the response
+	c, resp, err := websocket.Dial(ctx, url, opts) //nolint:bodyclose // websocket owns the response
 	if err != nil {
+		// A refused upgrade carries the server's reason in its body (the
+		// library keeps the first kilobyte). Without it the caller logs a
+		// bare status code.
+		if resp != nil && resp.Body != nil {
+			body, _ := io.ReadAll(io.LimitReader(resp.Body, 512))
+			if reason := strings.TrimSpace(string(body)); reason != "" {
+				return nil, fmt.Errorf("%w: the server answered %d: %s", err, resp.StatusCode, reason)
+			}
+		}
 		return nil, err
 	}
 	c.SetReadLimit(defaultReadLimit)
diff --git a/internal/ws/hub.go b/internal/ws/hub.go
index 09cf399f..f5af9f7c 100644
--- a/internal/ws/hub.go
+++ b/internal/ws/hub.go
@@ -613,6 +613,14 @@ func (h *Hub) ServeHTTP(w http.ResponseWriter, r *http.Request) {
 	token, ok := strings.CutPrefix(r.Header.Get("Authorization"), "Bearer ")
 	token = strings.TrimSpace(token)
 	if !ok || token == "" {
+		if r.URL.Query().Has("token") {
+			// A worker built before the token moved to the header. It
+			// cannot read this answer's body and will retry forever, so
+			// this log line is the only place the operator learns which
+			// host to upgrade. The token itself is never logged.
+			h.log.Warn("refused a site worker that sent its token in the URL: it runs a build from before 0.6.0; upgrade the slagworks package on that worker by hand, then rotate its token",
+				"remote", r.RemoteAddr)
+		}
 		http.Error(w, "missing worker token: send it as Authorization: Bearer <token>", http.StatusUnauthorized)
 		return
 	}
